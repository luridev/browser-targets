{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@protoapps/browser-targets": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/*.ts",
    "scripts/**/*.ts",
    "*.config.ts"
  ]
}
