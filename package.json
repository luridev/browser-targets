{
  "name": "@protoapps/browser-targets",
  "version": "0.1.0",
  "description": "Core browser build targets for Baseline Widely Available",
  "license": "MIT",
  "repository": "github:luridev/browser-targets",
  "homepage": "https://github.com/luridev/browser-targets#readme",
  "bugs": "https://github.com/luridev/browser-targets/issues",
  "author": "Anton V.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check:commit": "npm test && npm run lint && npm run typecheck",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepublishOnly": "npm --dry-run=false run check:commit",
    "prerelease": "jiti scripts/checkRelease.ts",
    "release": "npm run check:commit && bumpp",
    "test": "npm run test:unit && npm run test:package",
    "test:package": "npm run build && jiti scripts/verifyPackage.ts",
    "test:unit": "npm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "baseline",
    "browser",
    "build",
    "targets"
  ],
  "dependencies": {
    "baseline-browser-mapping": "^2.11.26"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@protoapps/eslint-config": "^0.3.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "bumpp": "^12.3.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.14",
    "publint": "^0.3.24",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "lefthook@2.1.14": true,
    "unrs-resolver": false
  }
}
